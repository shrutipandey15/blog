---
import Base from "../../layouts/Base.astro";
import Heading from "../../components/Heading.astro";
import PostList from "../../components/PostList.astro";
import { loadPosts, tagCounts } from "../../lib/posts";
import { u } from "../../lib/site";

export async function getStaticPaths() {
  const { LIVE } = await loadPosts();
  return tagCounts(LIVE).tags.map((tag) => ({
    params: { tag },
    props: { posts: LIVE.filter((p) => p.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag} — Aftertaste`} description={`Everything on Aftertaste tagged ${tag}.`}>
  <div class="page rise">
    <div class="phead">
      <Heading text={`#${tag}`} note={`${posts.length} ${posts.length === 1 ? "post" : "posts"}`} tag="h1" />
    </div>
    <PostList posts={posts} />
    <a class="btn" href={u("tags")} style="align-self:center">All tags</a>
  </div>
</Base>
