---
/* A small emblem stamped on each cover, since there is no cover art.
   Picked from the post id, so a book always gets the same one. */
const MOTIFS = [
  // moon and stars
  '<g fill="currentColor"><path d="M34 8a15 15 0 1 0 10 22A12 12 0 0 1 34 8z"/><path d="M12 34l1.6 4.4L18 40l-4.4 1.6L12 46l-1.6-4.4L6 40l4.4-1.6z"/><path d="M20 12l1 2.8 2.8 1-2.8 1-1 2.8-1-2.8-2.8-1 2.8-1z"/></g>',
  // arcs, like rain over a hill
  '<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 40a21 21 0 0 1 42 0"/><path d="M14 40a13 13 0 0 1 26 0"/><path d="M22 40a5 5 0 0 1 10 0"/><path d="M8 48h38"/></g>',
  // a sprig
  '<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M27 50V10"/><path d="M27 24c-9 0-12-6-10-12 6 0 11 5 10 12z"/><path d="M27 34c9 0 12-6 10-12-6 0-11 5-10 12z"/><path d="M27 42c-7 0-9-4-8-9 5 0 9 4 8 9z"/></g>',
  // key
  '<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="18" cy="18" r="8"/><path d="M24 24l20 20"/><path d="M36 36l6 6"/><path d="M31 41l5 5"/></g>',
  // waves
  '<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 20q7-7 14 0t14 0 14 0"/><path d="M6 30q7-7 14 0t14 0 14 0"/><path d="M6 40q7-7 14 0t14 0 14 0"/></g>',
  // candle
  '<g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M27 8c5 6 5 10 0 13-5-3-5-7 0-13z" fill="currentColor" stroke="none"/><rect x="20" y="24" width="14" height="22" rx="2"/><path d="M14 50h26"/></g>',
];

const { id = "" } = Astro.props;
let n = 0;
for (let i = 0; i < id.length; i++) n = (n * 31 + id.charCodeAt(i)) % 9973;
---
<svg class="motif" aria-hidden="true" viewBox="0 0 54 54" set:html={MOTIFS[n % MOTIFS.length]} />
